# Copy to .env.local (it is gitignored) and restart `npm run dev` after any change.
#
# true  = in-browser mock, no backend needed (default, and what the tests use)
# false = real Supabase backend
VITE_USE_MOCK=false

# Supabase dashboard > Project Settings > API (or the "Connect" button).
# Only the PUBLISHABLE (anon) key goes here. NEVER the secret / service_role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
