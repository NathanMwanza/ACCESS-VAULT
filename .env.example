# Copy to .env.local and adjust.
# true  = use the in-browser mock (Phase 1 default, no backend needed)
# false = call Prince's real endpoints (Phase 2)
VITE_USE_MOCK=true

# Base URL of Prince's auth endpoints (only used when VITE_USE_MOCK=false)
# e.g. a Supabase Edge Function URL: https://<project-ref>.supabase.co/functions/v1
VITE_API_URL=http://localhost:54321/functions/v1
